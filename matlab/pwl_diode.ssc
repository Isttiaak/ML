component pwl_diode
% Piecewise-linear diode (same equations as the Simscape Foundation Diode)
% Conducting (v > Vf): linear resistor Ron in series with Vf;
% blocking: linear conductance Goff.

    nodes
        p = foundation.electrical.electrical; % +:left
        n = foundation.electrical.electrical; % -:right
    end

    parameters
        Vf   = {0,    'V'};     % Forward voltage
        Ron  = {1e-4, 'Ohm'};   % On resistance
        Goff = {1e-8, '1/Ohm'}; % Off conductance
    end

    variables
        i = {0, 'A'};   % Current
        v = {0, 'V'};   % Voltage
    end

    branches
        i : p.i -> n.i;
    end

    equations
        v == p.v - n.v;
        if v > Vf
            i == (v - Vf)/Ron + Vf*Goff;
        else
            i == v*Goff;
        end
    end
end
